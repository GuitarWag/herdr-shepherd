#!/usr/bin/env python3
"""Show registered agents without changing their sessions."""
import argparse
import json
import os
import re
import subprocess
import sys
import time

C = {"idle": "\033[32m", "working": "\033[33m", "blocked": "\033[31m",
     "done": "\033[36m", "unknown": "\033[2m"}
DIM, RST, BOLD = "\033[2m", "\033[0m", "\033[1m"


def herdr(*args):
    """Return the herdr result or report its error."""
    response = subprocess.run(["herdr", *args], capture_output=True, text=True, check=True, timeout=10)
    data = json.loads(response.stdout)
    if "error" in data:
        raise ValueError(data["error"]["message"])
    return data["result"]


def repo_of(cwd):
    """Read the repository name with a local Git command."""
    if not cwd:
        return None
    try:
        r = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                           capture_output=True, text=True, timeout=5)
        url = r.stdout.strip()
        if not url:
            return None
        parts = url.rstrip("/").removesuffix(".git").replace(":", "/").split("/")
        return "/".join(parts[-2:])
    except Exception:
        return None


def role(agent):
    """Return the registered team role or the agent type."""
    n = agent.get("name") or ""
    return n.rsplit("-", 1)[1] if "-" in n else (agent.get("agent") or "?")


def collect():
    """Group team members by task and other agents by tab or folder."""
    agents = herdr("agent", "list")["agents"]
    tabs = {t["tab_id"]: (t.get("label") or "")
            for t in herdr("tab", "list")["tabs"]}
    groups = {}
    for a in agents:
        name = a.get("name") or ""
        match = re.fullmatch(r"(.+)-(boss|w[1-9][0-9]*)", name)
        if match:
            key, kind = match[1], "herd"
        else:
            label = tabs.get(a["tab_id"], "")
            # Use the folder when herdr gives the tab a number.
            key = label if label and not label.isdigit() else (
                os.path.basename((a.get("cwd") or "").rstrip("/")) or a["tab_id"])
            kind = "session"
        groups.setdefault((key, kind), []).append(a)
    return groups


def as_json(subject_filter=None):
    """Return groups with team members and their current states."""
    out = []
    for (subject, kind), members in collect().items():
        if subject_filter and subject != subject_filter:
            continue
        members = sorted(members, key=lambda a: (role(a) != "boss",
                                                 a.get("name") or a["pane_id"]))
        cwd = members[0].get("cwd") or ""
        out.append({
            "subject": subject,
            "kind": kind,
            "repo": repo_of(cwd) or cwd.replace(os.path.expanduser("~"), "~"),
            "cwd": cwd,
            "blocked": sum(1 for m in members if m.get("agent_status") == "blocked"),
            "working": sum(1 for m in members if m.get("agent_status") == "working"),
            "members": [{
                "name": m.get("name") or m["pane_id"],
                "role": role(m),
                "agent": m.get("agent") or "?",
                "status": m.get("agent_status") or "unknown",
                "pane_id": m["pane_id"],
                "cwd": m.get("cwd") or "",
            } for m in members],
        })
    out.sort(key=lambda h: (h["kind"] != "herd", -h["blocked"], -h["working"], h["subject"]))
    return out


def draw(subject_filter=None):
    rows = as_json(subject_filter)
    if not rows:
        print(f"{DIM}nothing running.{RST}")
        return
    for h in rows:
        mark = "" if h["kind"] == "herd" else f" {DIM}session{RST}"
        flag = f"  {C['blocked']}{h['blocked']} blocked{RST}" if h["blocked"] else ""
        print(f"\n{BOLD}{h['subject']}{RST}{mark}  {DIM}{h['repo']}{RST}{flag}")
        for m in h["members"]:
            st = m["status"]
            print(f"  {m['role']:<8} {m['agent']:<8} "
                  f"{C.get(st, '')}{st:<8}{RST} {DIM}{m['pane_id']}{RST}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--subject", help="Show one task.")
    parser.add_argument("--json", action="store_true", help="Print JSON.")
    parser.add_argument("--watch", action="store_true", help="Refresh every three seconds.")
    parser.add_argument("--version", action="version", version="herd-view 0.1.0")
    args = parser.parse_args()
    if args.json:
        print(json.dumps(as_json(args.subject)))
        return 0
    if args.watch:
        try:
            while True:
                print("\033[2J\033[H", end="")
                draw(args.subject)
                time.sleep(3)
        except KeyboardInterrupt:
            return 0
    draw(args.subject)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"herd-view: {error}", file=sys.stderr)
        sys.exit(1)
